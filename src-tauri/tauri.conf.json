{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Board Server",
  "version": "0.0.0",
  "identifier": "dev.mloureiro.agent-board-local-server",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": ["binaries/board-server", "binaries/board"],
    "resources": ["resources/frontend", "resources/drizzle", "resources/pglite", "resources/core-build.json"]
  },
  "build": {
    "beforeDevCommand": "pnpm core:build",
    "beforeBuildCommand": "pnpm core:build"
  }
}
